VIGIL_DATABASE_URL=postgresql://vigil:vigil@localhost:5432/vigil
VIGIL_VDEV_URL=http://localhost:8100
# ===== LLM (optional) =====
# Any OpenAI-compatible API. Leave LLM_BASE_URL or LLM_MODEL empty to switch the
# LLM off: alert text then comes from templates. To change the provider or the
# model, change these three values; no code changes.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
# Optional spending limits.
# Token limit for one answer, including any hidden reasoning (an answer that does
# not fit is dropped and the template is shown):
#LLM_MAX_TOKENS=1000
# At most this many requests per hour; further alerts keep the template (0 = no cap):
#LLM_MAX_CALLS_PER_HOUR=30
# Optional. Extra request fields some providers need, as JSON in single quotes,
# for example to switch a reasoning mode off:
#LLM_EXTRA_BODY='{"thinking": {"type": "disabled"}}'
# Missing file means the rule-based pattern (TASK §8.3).
VIGIL_PATTERN_MODEL=ml/models/pattern.json
VIGIL_ACTIONS_FILE=docs/actions.yaml
# Comma separated; * allows any origin.
VIGIL_CORS_ORIGIN=*

# ===== DB =====
POSTGRES_HOST=5432

# ===== Traefik (only with compose.traefik.yml) =====
# Public host name; /api/* is routed to the backend, the rest to the client.
DOMAIN_URL=vigil.example.org
# Compose project name; also the prefix of the Traefik router names.
COMPOSE_PROJECT_NAME=vigil
# Optional contact e-mail for the Let's Encrypt account (TRAEFIK_MODE=own).
ACME_EMAIL=
# own      = start the Traefik that ships with this project (ports 80 and 443)
# external = a Traefik already runs on this server, on the Docker network `traefik`
TRAEFIK_MODE=own
