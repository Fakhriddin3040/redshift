VIGIL_DATABASE_URL=postgresql://vigil:vigil@localhost:5432/vigil
VIGIL_VDEV_URL=http://localhost:8100
# Empty disables the LLM narrator.
VIGIL_OLLAMA_URL=
# Missing file means the rule-based pattern (TASK §8.3).
VIGIL_PATTERN_MODEL=ml/models/pattern.json
VIGIL_ACTIONS_FILE=docs/actions.yaml
# Comma separated; * allows any origin.
VIGIL_CORS_ORIGIN=*

# ===== DB =====
POSTGRES_HOST=5432

# ===== Traefik (only with compose.traefik.yml) =====
# Public host name; /api/* is routed to the backend, the rest to the client.
DOMAIN_URL=vigil.example.org
# Compose project name; also the prefix of the Traefik router names.
COMPOSE_PROJECT_NAME=vigil
# Optional contact e-mail for the Let's Encrypt account (TRAEFIK_MODE=own).
ACME_EMAIL=
# own      = start the Traefik that ships with this project (ports 80 and 443)
# external = a Traefik already runs on this server, on the Docker network `traefik`
TRAEFIK_MODE=own
